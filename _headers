/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
  X-Content-Type-Options: nosniff

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/download/*.pkg
  Content-Type: application/octet-stream
  Content-Disposition: attachment

# The home page (new site, 2026-11-22, DRAFT for the orchestrator's check): one same-origin script (/site.js:
# page switching, menu, theme) and the self-hosted fonts in /fonts/. Still no inline script, no form.
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/site.js
  Cache-Control: no-cache

# CR-SITEDARK.1: /theme.js carries the saved light/dark choice (key "bervo-theme", set by the home page toggle) onto
# Terms, Privacy, /invite and /invite-thanks. The site-wide policy stays script-free; Terms and Privacy get their own
# block below (same shape as /invite-thanks). The 404 page has no script (its path is any path), so it follows the device only.
/terms
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/privacy
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/theme.js
  Cache-Control: no-cache

# /invite only (CR-INVITEFLOW.1): the form posts to itself and loads Cloudflare Turnstile. The "!" line removes
# the site-wide policy above for this path (Pages would otherwise send both, and a browser enforces both).
/invite
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# /invite-thanks only (CR-INVITEFLOW.1): one same-origin script that greets by first name; still no form.
/invite-thanks
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The form's scripts: always revalidate, so a visitor never runs an older script against a newer page (11-11:
# the default 4-hour cache kept the old /invite.js after a publish). The page also loads them with ?v=N.
/invite.js
  Cache-Control: no-cache

/invite-thanks.js
  Cache-Control: no-cache

# CR-LINKPREVIEW.1: /go/<label>/<page> is a Pages Function (functions/go/[[path]].js), which sets its own headers
# (Pages does not apply this file to a Function's response). This block says the same, in case it ever does: one
# same-origin script, /go.js, revalidated on every load like the other scripts.
/go/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/go.js
  Cache-Control: no-cache

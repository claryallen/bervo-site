/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
  X-Content-Type-Options: nosniff

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/download/*.pkg
  Content-Type: application/octet-stream
  Content-Disposition: attachment

# /invite only (CR-INVITEFLOW.1): the form posts to itself and loads Cloudflare Turnstile. The "!" line removes
# the site-wide policy above for this path (Pages would otherwise send both, and a browser enforces both).
/invite
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# /invite-thanks only (CR-INVITEFLOW.1): one same-origin script that greets by first name; still no form.
/invite-thanks
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The form's scripts: always revalidate, so a visitor never runs an older script against a newer page (11-11:
# the default 4-hour cache kept the old /invite.js after a publish). The page also loads them with ?v=N.
/invite.js
  Cache-Control: no-cache

/invite-thanks.js
  Cache-Control: no-cache
